# Ignore all .env files in any folder
**/.env
**/.env.*

# Ignore node_modules in root, frontend, and backend
node_modules/
frontend/node_modules/
backend/node_modules/

# Ignore dist folders in frontend and backend
dist/
frontend/dist/
backend/dist/

# Ignore package-lock.json in root, frontend, and backend
package-lock.json
frontend/package-lock.json
backend/package-lock.json

# Optional: Ignore logs
**/*.log
